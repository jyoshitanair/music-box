unsigned long time = 0; 
float E4 = 329.63;
float C4 = 262; 
float G4 = 392; 
float D4 = 294; 
int button1 = 11; 
int button2 = 12; 
int buzzer = 10; 
int i = 0; 
bool lastb1pressed = false;
bool lastb2pressed = false;
bool playSong = false; 
bool notePlaying = false;
int qnote = 100; 
int hnote = qnote*2; 
float note1[][3] = {
  {D4,5,0.1},
  {E4,4,0.1},
  {C4,5,0.1},
  {G4,1,0.1},
  {D4,1,0.1}};
float note2[][3] = {
  {C4,1,1.1},
  {C4,1,0.1},
  {C4,1,0.1},
  {C4,1,0.1},
  {C4,1,0.1}};
int cursong = 0; 
void setup() {
  Serial.begin(9600); 
  pinMode(buzzer, OUTPUT);
  pinMode(button1, INPUT_PULLUP);
  pinMode(button2, INPUT_PULLUP);
}

void loop() {
  bool b1pressed = (digitalRead(button1) == LOW);
  bool b2pressed = (digitalRead(button2) == LOW);
  if (((b1pressed && !lastb1pressed) || (b2pressed && !lastb2pressed)) && !playSong){
    Serial.println("button pressed!");
    time = millis();
    cursong = b1pressed? 0:1;
    playSong = true;
    i=0;
    notePlaying = false;
  }
  lastb1pressed = b1pressed; 
  lastb1pressed = b2pressed;
  if(playSong){
    Serial.println("start!");
    if(i>=5){
      Serial.println("end!");
      playSong = false;
      noTone(buzzer);
    }else{
      if(cursong == 0){
        play(note1[i]);
        Serial.println("play 1!");
      }else{
        play(note2[i]);
        Serial.println("play 2!");
      }
    }
  }
}
void play(float array[]){
  Serial.println("PLAYING STH");
  float note = array[0];
  static unsigned long buttontime = 0; 
  unsigned long duration = array[1] * 1000;
  unsigned long pause = array[2] *1000;
  unsigned long totalduartion = duration + pause;
  if(!notePlaying){
    buttontime = millis();
    Serial.println("START PLAYING");
    tone(buzzer, note);
    notePlaying = true;
  }
  else if (notePlaying && (millis() - buttontime >= duration) && (millis() - buttontime < totalduartion)) {
    Serial.println("STOP PLAYING");
    noTone(buzzer);
  }
  if(millis() - buttontime >= totalduartion){
    Serial.println("MOVE ON");
    i++;
    time = millis();
    notePlaying = false;
    buttontime = 0; 
    }
  }
